# Copiar para .env na máquina do cliente. NUNCA commitar o .env.

# Caminho do executável ou atalho do msAdmin (ajustar após Fase 0)
MSADMIN_EXE=C:\Caminho\Para\msAdmin.exe

# Titulo parcial da janela (na barra: mxAdmin 1.0 [Rev ...])
MSADMIN_WINDOW_TITLE=mxAdmin

# Credenciais do sistema (usuário dedicado ao robô, se possível)
MSADMIN_USER=
MSADMIN_PASSWORD=

# Backend de UI: auto | uia | playwright | mock
# mock = desenvolvimento sem o msAdmin aberto
UI_BACKEND=mock

# Dados locais
DATA_DIR=./data
ARTIFACTS_DIR=./artifacts

# Fuso
TZ=America/Sao_Paulo

# Google Calendar (fase integrações)
GOOGLE_CREDENTIALS_JSON=
GOOGLE_CALENDAR_ID=

# WhatsApp / Evolution (fase integrações)
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
WHATSAPP_FROM=

# Agente de IA (fase 4 — desligado por padrão)
AGENT_ENABLED=false
OPENAI_API_KEY=
AGENT_MODEL=gpt-4.1-mini

# MCP remoto (Cursor no PC do Marcos -> este PC via Tailscale)
# Gere um token longo: powershell -c "[guid]::NewGuid().ToString('N')"
MCP_TOKEN=
MCP_HOST=0.0.0.0
MCP_PORT=8765
